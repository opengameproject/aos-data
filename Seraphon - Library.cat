          </characteristics>
        </profile>
        <profile name="Crimson Frenzy" id="2fba-6486-7873-86a9" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
