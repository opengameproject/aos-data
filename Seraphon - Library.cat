        <profile name="Leaping Horror" id="26bd-f1e8-795f-dabf" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Red</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Movement</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Any Combat Phase</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb">If this unit charged this turn, pick a visible enemy **^^Hero^^** within 12&quot; of it to be the target.</characteristic>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Roll 2D6. This unit can move a distance up to the value of the roll. During that move, it can pass through models in enemy **^^Infantry^^** units but must end that move in combat with the target.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
        <profile name="Fury of the Pack" id="ef31-fded-f0c3-5994" hidden="false" typeId="55ac-f837-dded-5872" typeName="Ability (Command)">
          <attributes>
            <attribute name="Color" typeId="5c69-e4b9-19bc-e801">Red</attribute>
            <attribute name="Type" typeId="2bd5-08f1-f3d1-86f7">Offensive</attribute>
            <attribute name="Parent Node" typeId="df75-e7dc-12b5-48a8"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="736-6e3a-d0b5-a1b0">Once Per Turn (Army), Any Combat Phase</characteristic>
            <characteristic name="Cost" typeId="a49e-3082-e2a6-e802">1</characteristic>
            <characteristic name="Declare" typeId="b77f-7548-840e-c086">Pick a visible friendly **Aggradon Lancers** unit wholly within 12&quot; of this unit to be the target.</characteristic>
            <characteristic name="Effect" typeId="2111-3ca8-61dd-a5f0">For the rest of the turn, add 1 to the Attacks characteristic of the target&apos;s **Companion** weapons for each model in the target unit that is slain. In addition, the target cannot use commands for the rest of the phase.

Designer&apos;s Note: Models that have been slain and returned to the target unit do not count as being slain for the purposes of this ability.</characteristic>
            <characteristic name="Keywords" typeId="445d-f443-5448-e7ce"/>
          </characteristics>
        </profile>
      </profiles>
