        <profile name="Concentrated Beam" id="8320-79b1-186e-4945" hidden="false" typeId="59b6-d47a-a68a-5dcc" typeName="Ability (Activated)">
          <attributes>
            <attribute name="Color" typeId="5a11-eab3-180c-ddf5">Blue</attribute>
            <attribute name="Type" typeId="6d16-c86b-2698-85a4">Offensive</attribute>
            <attribute name="Parent Node" typeId="2d74-4dcd-8468-87fa"/>
          </attributes>
          <characteristics>
            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Turn (Army), Reaction: You declared the &apos;Shoot&apos; ability for this unit and all of the attacks made by this unit&apos;s **Solar Engine** target the same enemy unit</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">Remove all **solar focus** points from all enemy units that are not a target of that **^^Shoot^^** ability. Then, give 1 **solar focus point** to the target of all the attacks made by this unit&apos;s **Solar Engine**. Then, add X to the Damage characteristic of this unit&apos;s **Solar Engine** for the rest of the phase, where X is equal to the number of **solar focus points** the target of those attacks has.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
      </profiles>
