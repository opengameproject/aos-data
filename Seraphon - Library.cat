            <characteristic name="Timing" typeId="652c-3d84-4e7-14f4">Once Per Battle, End of Your Turn</characteristic>
            <characteristic name="Declare" typeId="bad3-f9c5-ba46-18cb"/>
            <characteristic name="Effect" typeId="b6f1-ba36-6cd-3b03">If an enemy **dark omen** was destroyed this turn, pick 1 of the following **asterisms** to witness: &apos;Coils of Sotek&apos;, &apos;Rays of Chotec&apos;, &apos;Jaws of Itzl&apos; or &apos;Eye of Tepok&apos;.</characteristic>
            <characteristic name="Keywords" typeId="12e8-3214-7d8f-1d0f"/>
            <characteristic name="Used By" typeId="1b32-c9d6-3106-166b"/>
          </characteristics>
        </profile>
